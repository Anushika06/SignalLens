# SignalLens backend configuration. Copy to backend/.env and fill in.
# Keys are read from the environment first, then from this file. Never commit backend/.env.

# --- Database -----------------------------------------------------------------------------
# Any Postgres URL works: postgresql+asyncpg://..., or a hosted provider's postgres://...?sslmode=require
# string (Supabase, Neon, Render) — it is converted for the async driver automatically.
SL_DATABASE_URL=postgresql+asyncpg://signallens:signallens@127.0.0.1:5432/signallens
# Long random string (>= 32 chars). Required in production (SL_ENV=prod).
SL_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
# SL_ENV=dev
# SL_PUBLIC_APP_URL=http://localhost:3000     # the web app; used for SSO redirects and email links
# SL_PUBLIC_API_URL=http://127.0.0.1:8000     # this API

# --- Model: NVIDIA NIM (free developer key from https://build.nvidia.com) -------------------
NVIDIA_API_KEY=
# SL_LLM_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b        # extraction, triage, materiality
# SL_LLM_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b   # planning, investigation, impact, Ask
# SL_LLM_TIMEOUT_S=90
# SL_LLM_FALLBACK_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b   # tried when a model stalls
# SL_LLM_THINKING=off             # off (fastest) | reasoning (hidden reasoning on the reasoning tier) | all

# --- Search: set at least ONE (auto-detected in this order: Tavily, Exa, Serper) -----------
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
# SL_SEARCH_PROVIDER=auto

# --- Collection -----------------------------------------------------------------------------
# SL_USER_AGENT=SignalLensBot/0.1 (+https://your-domain/bot)
# SL_RESPECT_ROBOTS=true
# SL_BACKFILL_MONTHS=12
# JavaScript rendering for pages that are empty JS shells (needs `uv sync --extra browser`
# and `uv run playwright install chromium`, or the Docker image built with INSTALL_BROWSER=1).
# SL_RENDER_JS=false

# --- Worker ---------------------------------------------------------------------------------
# SL_WORKER_CONCURRENCY=4
# SL_RUN_WORKER_IN_API=false      # true = one process serves the API and runs the agents
# SL_DIGEST_HOUR_UTC=3            # daily digest time (03:00 UTC = 08:30 IST)

# --- Agent budgets --------------------------------------------------------------------------
# SL_PLANNER_MAX_STEPS=10
# SL_INVESTIGATION_MAX_STEPS=10

# --- Hosted agent endpoint (aiKart method 2: POST /api/agent/brief) ------------------------
# SL_AGENT_API_KEYS=              # comma-separated keys for the X-API-Key header; empty = open
# SL_AGENT_RATE_LIMIT_PER_HOUR=30
# SL_BRIEF_TIMEOUT_S=240
# The aiKart container (method 1) delegates to a hosted SignalLens when it has no model keys:
# SL_REMOTE_AGENT_URL=https://your-api.onrender.com
# SL_REMOTE_AGENT_KEY=

# --- Demo lab (fictional pages you can edit to demonstrate change detection) ---------------
# SL_SANDBOX_ENABLED=true
# SL_DEMO_LOGIN=              # show the demo-account shortcut on sign-in (default: on unless SL_ENV=prod)

# --- Optional: email (daily digests, alerts, approved external shares) ---------------------
# auto = Brevo if BREVO_API_KEY, else Resend if RESEND_API_KEY, else SMTP if SL_SMTP_HOST.
# Many free hosts block SMTP ports, so prefer an HTTP API (Brevo: 300 emails/day free).
# BREVO_API_KEY=
# RESEND_API_KEY=
# SL_EMAIL_FROM=you@example.com   # a sender address verified with the provider
# SL_EMAIL_FROM_NAME=SignalLens
# SL_EMAIL_PROVIDER=auto          # auto | brevo | resend | smtp | none
# SL_DIGEST_EMAIL_ENABLED=true
# SL_SMTP_HOST=
# SL_SMTP_PORT=587
# SL_SMTP_USER=
# SL_SMTP_PASSWORD=
# SL_SMTP_FROM=

# --- Optional: single sign-on (OpenID Connect — Google, Microsoft Entra, Okta, ...) ---------
# Redirect URI to register with the provider: {SL_PUBLIC_APP_URL}/api/auth/sso/callback
# SL_OIDC_ISSUER=https://accounts.google.com
# SL_OIDC_CLIENT_ID=
# SL_OIDC_CLIENT_SECRET=
# SL_OIDC_PROVIDER_NAME=Google
# SL_OIDC_ALLOWED_DOMAINS=        # comma-separated email domains; empty = any verified email
